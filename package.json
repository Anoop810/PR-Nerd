{
  "name": "prnerd",
  "version": "0.1.0",
  "description": "BYOK AI PR reviewer that investigates before it reviews — Static Pack → Agentic Investigation → Structured Review",
  "type": "module",
  "bin": {
    "pr-review": "./dist/cli/index.js",
    "prnerd": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pr-review",
    "code-review",
    "ai",
    "byok",
    "github-actions",
    "static-pack",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "openai": "^4.104.0",
    "yaml": "^2.7.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  }
}
